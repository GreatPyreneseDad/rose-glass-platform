# Rose Glass Platform - Environment Variables
# Copy this file to .env and fill in your API keys

# At least one of these is required:
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Database path (defaults to ./rose_glass.db)
# DATABASE_PATH=/path/to/rose_glass.db

# Optional: Server port (defaults to 8420)
# PORT=8420
