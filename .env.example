# Rose Glass Platform - Environment Variables
# Copy this file to .env and fill in your API keys

# ============== API Keys ==============
# At least one of these is required:
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ============== Database Configuration ==============
# LOCAL DEVELOPMENT (SQLite - automatic):
# No configuration needed. Will use ./rose_glass.db by default.

# PRODUCTION/VERCEL (PostgreSQL):
# Set DATABASE_URL to your PostgreSQL connection string.
# The system automatically switches to PostgreSQL when DATABASE_URL is set and not sqlite://
# DATABASE_URL=postgresql://user:password@host:5432/database

# For Vercel Postgres:
# DATABASE_URL=postgres://default:password@host.vercel-storage.com:5432/verceldb

# Optional: Custom SQLite path for local development
# DATABASE_PATH=/path/to/rose_glass.db

# ============== Server Configuration ==============
# Optional: Server port (defaults to 8420)
# PORT=8420
